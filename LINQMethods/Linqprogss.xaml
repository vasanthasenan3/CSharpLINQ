<Window x:Class="LogicalProgsPractice.Linqprogss"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogicalProgsPractice"
        mc:Ignorable="d"
        Title="Linqprogss" Height="750" Width="1000">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="MediumTurquoise" Offset="0"></GradientStop>
            <GradientStop Color="Black" Offset="1"></GradientStop>
        </LinearGradientBrush>
    </Window.Background>
    <Grid Margin="20">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="MediumTurquoise" Offset="0"></GradientStop>
                <GradientStop Color="Black" Offset="1"></GradientStop>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="9.04"/>
            <RowDefinition Height="94.823"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border
    Grid.Row="0"
    Background="Transparent"
           
    CornerRadius="10"
    Padding="20" Margin="0,0,0,15" Grid.RowSpan="3">

            <StackPanel >
                <TextBlock
            Text="LINQ Practice Application"
            FontSize="28"
            FontWeight="Bold"
            Foreground="Black"/>

                <TextBlock
            Margin="0,8,0,0"
            Text="Select any LINQ method and click Execute."
            Foreground="Black"
            FontSize="14"/>

            </StackPanel>

        </Border>

        <!-- Main Content -->

        <Grid Grid.Row="3">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="320"/>

                <ColumnDefinition Width="20"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <!-- Left Panel -->

            <Border
        Grid.Column="0"
      
        CornerRadius="10"
        Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="MediumTurquoise" Offset="0"></GradientStop>
                        <GradientStop Color="Black" Offset="1"></GradientStop>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>

                    <TextBlock
                Text="LINQ Methods"
                FontSize="22"
                FontWeight="Bold"
                Margin="0,0,0,15"/>

                    <ComboBox
                x:Name="cmbMethods"
                Height="35"
                FontSize="16">

                        <ComboBoxItem Content="Where()"/>
                        <ComboBoxItem Content="Select()"/>
                        <ComboBoxItem Content="OrderBy()"/>
                        <ComboBoxItem Content="OrderByDescending()"/>
                        <ComboBoxItem Content="First()"/>
                        <ComboBoxItem Content="FirstOrDefault()"/>
                        <ComboBoxItem Content="Take()"/>
                        <ComboBoxItem Content="Count()"/>
                        <ComboBoxItem Content="Sum()"/>
                        <ComboBoxItem Content="Average()"/>
                        <ComboBoxItem Content="Min()"/>
                        <ComboBoxItem Content="Max()"/>
                        <ComboBoxItem Content="ToList()"/>
                        <ComboBoxItem Content="GroupBy()"/>
                        <ComboBoxItem Content="SelectMany()"/>
                        <ComboBoxItem Content="Concat()"/>
                        <ComboBoxItem Content="Except()"/>
                        <ComboBoxItem Content="Range()"/>

                    </ComboBox>

                    <Button
                x:Name="btnExecute"
                    Click="btnExecute_Click"
                Margin="0,25,0,0"
                Height="45"
                FontSize="16"
                FontWeight="Bold"
                Background="#2D89EF"
                Foreground="White"
            
                Content="Execute"/>

                    <Button
                x:Name="btnClear"
                Margin="0,10,0,0"
                        Click="btnClear_Click"
                Height="45"
                FontSize="16"
                FontWeight="Bold"
                Background="#D9534F"
                Foreground="White"
          
                Content="Clear Output"/>

                </StackPanel>

            </Border>

            <!-- Right Panel -->

            <Border
        Grid.Column="2"
      
        CornerRadius="10"
        Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="MediumTurquoise" Offset="0"></GradientStop>
                        <GradientStop Color="Black" Offset="1"></GradientStop>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="10"/>

                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock
                Text="Output"
                FontSize="22"
                FontWeight="Bold"/>

                    <ListBox
                Grid.Row="2"
                        BorderThickness="3"
                 BorderBrush="Gold"
                x:Name="lstOutput"
                FontSize="16"/>
                   
                </Grid>

            </Border>

        </Grid>

    </Grid>
</Window>
